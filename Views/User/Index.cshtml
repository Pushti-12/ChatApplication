@model IEnumerable<ChatApplication.Models.User>

@{
    ViewData["Title"] = "Users";
}

<link rel="stylesheet" href="~/css/user.css" />

<div class="user-page">

    <div class="user-container">

        <!-- HEADER -->

        <div class="user-page-header">

            <div>
                <h1>Users</h1>

                <p>
                    Manage registered users and their accounts.
                </p>
            </div>

            <a asp-action="Create"
               class="user-primary-btn">

                <span>+</span>
                Add New User

            </a>

        </div>


        <!-- SEARCH -->

        <div class="user-card">

            <form asp-action="Index"
                  method="get"
                  class="user-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Search users by name or email..." />

                <button type="submit">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <a asp-action="Index"
                       class="user-clear">
                        Clear
                    </a>
                }

            </form>

        </div>


        <!-- USERS -->

        <div class="user-card">

            <div style="margin-bottom:20px;">

                <h2 style="margin:0;">
                    All Users
                </h2>

                <p style="margin:6px 0 0;color:#858ba0;font-size:13px;">
                    @Model.Count() registered accounts
                </p>

            </div>


            @if (!Model.Any())
            {
                <div class="user-empty">

                    <div class="user-empty-icon">
                        ♙
                    </div>

                    <h3>No users found</h3>

                    <p>
                        Try another search or create a new user.
                    </p>

                </div>
            }
            else
            {
                <div class="user-table-wrapper">

                    <table class="user-table">

                        <thead>

                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="user-info">

                                            <div class="user-avatar">

                                                @if (!string.IsNullOrWhiteSpace(user.Name))
                                                {
                                                    @user.Name.Substring(0, 1).ToUpper()
                                                }

                                            </div>

                                            <div class="user-name">
                                                @user.Name
                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @user.PhoneNumber
                                    </td>

                                    <td>

                                        <span class="user-role">
                                            @user.Role
                                        </span>

                                    </td>

                                    <td>
                                        @user.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <div class="user-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="user-edit-btn">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this user?');">

                                                <button type="submit"
                                                        class="user-delete-btn">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>