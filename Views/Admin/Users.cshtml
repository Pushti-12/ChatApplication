@model IEnumerable<ChatApplication.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-layout">

    <aside class="admin-sidebar">

        <div class="brand">

            <div class="brand-icon">C</div>

            <div>
                <h2>ChatApp</h2>
                <span>Administration</span>
            </div>

        </div>

        <nav class="admin-nav">

            <a asp-action="Index"
               class="nav-item">

                <span>▦</span>
                Dashboard

            </a>

            <a asp-action="Users"
               class="nav-item active">

                <span>♙</span>
                Users

            </a>

        </nav>

        <div class="sidebar-bottom">

            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post">

                <button class="logout-button"
                        type="submit">

                    <span>↪</span>
                    Logout

                </button>

            </form>

        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-header">

            <div>

                <p class="eyebrow">
                    MANAGEMENT
                </p>

                <h1>Users</h1>

                <p class="header-subtitle">
                    Manage all registered users.
                </p>

            </div>

            <a asp-controller="User"
               asp-action="Create"
               class="primary-button">

                + Add User

            </a>

        </header>


        <!-- SEARCH -->

        <section class="dashboard-card">

            <form asp-action="Users"
                  method="get"
                  class="search-bar">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Search by name, email or role..." />

                <button type="submit">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <a asp-action="Users">
                        Clear
                    </a>
                }

            </form>

        </section>


        <!-- USERS TABLE -->

        <section class="dashboard-card">

            <div class="section-header">

                <div>

                    <h2>All Users</h2>

                    <p>
                        @Model.Count() registered users
                    </p>

                </div>

            </div>


            <div class="table-wrapper">

                <table class="admin-table">

                    <thead>

                        <tr>

                            <th>User</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Created</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>

                                    <div class="table-user">

                                        <div class="user-avatar">
                                            @user.Name.Substring(0, 1).ToUpper()
                                        </div>

                                        <strong>
                                            @user.Name
                                        </strong>

                                    </div>

                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    @user.PhoneNumber
                                </td>

                                <td>

                                    <span class="role-badge">
                                        @user.Role
                                    </span>

                                </td>

                                <td>
                                    @user.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-controller="User"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="edit-button">
                                            Edit
                                        </a>

                                        <form asp-controller="User"
                                              asp-action="Delete"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this user?');">

                                            <button type="submit"
                                                    class="delete-button">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>