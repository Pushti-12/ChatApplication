@{
    Layout = null;
    ViewData["Title"] = "Script Lab";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Script Lab - ChatApplication</title>


    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }


            body {
                font-family: Inter, "Segoe UI", Arial, sans-serif;
                background: linear-gradient( 135deg, #f8fafc, #eef2ff );
                color: #172033;
                min-height: 100vh;
            }


            button,
            textarea {
                font-family: inherit;
            }


            button {
                -webkit-tap-highlight-color: transparent;
            }


            .script-page {
                min-height: 100vh;
                padding: 28px;
            }


            .script-container {
                width: 100%;
                max-width: 1400px;
                margin: 0 auto;
            }


            /* =====================================================
                           HEADER
                        ===================================================== */

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                margin-bottom: 28px;
            }


            .heading-section {
                display: flex;
                align-items: center;
                gap: 16px;
                min-width: 0;
            }


            .back-button {
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: white;
                border: 1px solid #e5e7eb;
                color: #475569;
                text-decoration: none;
                font-size: 20px;
                transition: .2s ease;
                flex-shrink: 0;
            }


                .back-button:hover {
                    transform: translateX(-2px);
                    background: #f8fafc;
                }


            .page-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 16px;
                background: linear-gradient( 135deg, #4f46e5, #7c3aed );
                color: white;
                font-size: 25px;
                box-shadow: 0 10px 25px rgba(79, 70, 229, .25);
                flex-shrink: 0;
            }


            .eyebrow {
                color: #6366f1;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 1.5px;
                margin-bottom: 4px;
            }


            .heading-text {
                min-width: 0;
            }


                .heading-text h1 {
                    font-size: 28px;
                    font-weight: 750;
                    color: #111827;
                }


                .heading-text p {
                    margin-top: 5px;
                    color: #64748b;
                    font-size: 14px;
                }


            /* =====================================================
                           CONNECTION CARD
                        ===================================================== */

            .connection-card {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 15px;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 14px;
                box-shadow: 0 8px 25px rgba(15, 23, 42, .06);
                flex-shrink: 0;
            }


            .connection-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #f59e0b;
                transition: .2s ease;
            }


                .connection-dot.connected {
                    background: #22c55e;
                    box-shadow: 0 0 0 5px rgba(34, 197, 94, .12);
                }


                .connection-dot.error {
                    background: #ef4444;
                    box-shadow: 0 0 0 5px rgba(239, 68, 68, .10);
                }


            .connection-text {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }


                .connection-text strong {
                    font-size: 13px;
                }


                .connection-text span {
                    color: #94a3b8;
                    font-size: 11px;
                }


            /* =====================================================
                           WORKSPACE
                        ===================================================== */

            .workspace {
                display: grid;
                grid-template-columns: minmax(0, 1.55fr) minmax(360px, .8fr);
                gap: 24px;
            }


            .panel {
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(15, 23, 42, .07);
                min-width: 0;
            }


            .panel-header {
                padding: 20px 24px;
                border-bottom: 1px solid #eef2f7;
            }


            .panel-title {
                display: flex;
                align-items: center;
                gap: 12px;
            }


            .panel-title-icon {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: #eef2ff;
                color: #4f46e5;
                font-weight: 800;
            }


            .panel-title h2 {
                font-size: 16px;
                color: #111827;
            }


            .panel-title span {
                display: block;
                margin-top: 3px;
                font-size: 12px;
                color: #94a3b8;
            }


            /* =====================================================
                           EDITOR
                        ===================================================== */

            .editor-section {
                padding: 24px;
            }


            .editor-box {
                border-radius: 17px;
                overflow: hidden;
                background: #0f172a;
                border: 1px solid #1e293b;
                box-shadow: 0 15px 35px rgba(15, 23, 42, .18);
            }


            .editor-top {
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 14px;
                border-bottom: 1px solid #1e293b;
            }


            .editor-dots {
                display: flex;
                gap: 7px;
            }


                .editor-dots span {
                    width: 10px;
                    height: 10px;
                    border-radius: 50%;
                    background: #475569;
                }


            .editor-language {
                color: #94a3b8;
                font-size: 11px;
            }


            #scriptInput {
                width: 100%;
                min-height: 340px;
                resize: vertical;
                display: block;
                border: none;
                outline: none;
                padding: 24px;
                background: #0f172a;
                color: #e2e8f0;
                font-family: Consolas, "Courier New", monospace;
                font-size: 14px;
                line-height: 1.7;
            }


                #scriptInput::placeholder {
                    color: #64748b;
                }


            .editor-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                margin-top: 14px;
            }


            .character-count {
                color: #94a3b8;
                font-size: 12px;
            }


            .editor-actions {
                display: flex;
                gap: 10px;
            }


            .secondary-button,
            .primary-button {
                border: none;
                border-radius: 11px;
                padding: 12px 18px;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                transition: .2s ease;
            }


            .secondary-button {
                background: #f1f5f9;
                color: #475569;
            }


                .secondary-button:hover {
                    background: #e2e8f0;
                }


            .primary-button {
                background: linear-gradient( 135deg, #4f46e5, #7c3aed );
                color: white;
                box-shadow: 0 8px 20px rgba(79, 70, 229, .22);
            }


                .primary-button:hover:not(:disabled) {
                    transform: translateY(-1px);
                    box-shadow: 0 12px 25px rgba(79, 70, 229, .3);
                }


                .primary-button:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                    transform: none;
                }


            /* =====================================================
                           QUICK ACTIONS
                        ===================================================== */

            .templates {
                margin-top: 22px;
            }


            .templates-title {
                margin-bottom: 11px;
                font-size: 12px;
                font-weight: 800;
                color: #475569;
            }


            .template-list {
                display: flex;
                flex-wrap: wrap;
                gap: 9px;
            }


            .template-button {
                border: 1px solid #e2e8f0;
                background: white;
                color: #475569;
                padding: 9px 12px;
                border-radius: 10px;
                font-size: 12px;
                cursor: pointer;
                transition: .2s ease;
            }


                .template-button:hover {
                    border-color: #818cf8;
                    color: #4f46e5;
                    background: #eef2ff;
                    transform: translateY(-1px);
                }


                .template-button:active {
                    transform: translateY(0);
                }


            /* =====================================================
                           PREVIEW
                        ===================================================== */

            .preview-body {
                padding: 18px;
            }


            .preview-frame {
                width: 100%;
                height: 370px;
                border: 1px solid #e2e8f0;
                border-radius: 15px;
                overflow: hidden;
                background: white;
            }


            #scriptSandbox {
                width: 100%;
                height: 100%;
                border: none;
                display: block;
            }


            .execution-status {
                margin: 0 18px 18px;
                padding: 13px 15px;
                display: flex;
                align-items: center;
                gap: 10px;
                border-radius: 12px;
                background: #f8fafc;
                color: #64748b;
                font-size: 12px;
                transition: .2s ease;
            }


                .execution-status.success {
                    background: #f0fdf4;
                    color: #15803d;
                }


                .execution-status.error {
                    background: #fef2f2;
                    color: #dc2626;
                }


            .status-icon {
                font-size: 15px;
            }


            .info-card {
                margin: 0 18px 18px;
                padding: 17px;
                border: 1px solid #e2e8f0;
                border-radius: 14px;
                background: #f8fafc;
            }


                .info-card strong {
                    font-size: 13px;
                    color: #334155;
                }


                .info-card p {
                    margin-top: 8px;
                    color: #64748b;
                    font-size: 12px;
                    line-height: 1.6;
                }


            /* =====================================================
                           FOCUS
                        ===================================================== */

            button:focus-visible,
            textarea:focus-visible,
            a:focus-visible {
                outline: 3px solid rgba(99, 102, 241, .25);
                outline-offset: 2px;
            }


            /* =====================================================
                           RESPONSIVE
                        ===================================================== */

            @@media (max-width: 1000px) {

                .workspace {
                    grid-template-columns: 1fr;
                }


                .preview-frame {
                    height: 420px;
                }


                .top-bar {
                    align-items: flex-start;
                }
            }


            @@media (max-width: 650px) {

                .script-page {
                    padding: 15px;
                }


                .top-bar {
                    flex-direction: column;
                }


                .heading-section {
                    width: 100%;
                }


                .connection-card {
                    width: 100%;
                }


                .heading-text h1 {
                    font-size: 23px;
                }


                .editor-footer {
                    flex-direction: column;
                    align-items: stretch;
                }


                .editor-actions {
                    width: 100%;
                }


                .secondary-button,
                .primary-button {
                    flex: 1;
                }


                #scriptInput {
                    min-height: 280px;
                }


                .preview-frame {
                    height: 380px;
                }
            }

    </style>

</head>


<body>

    <div class="script-page">

        <div class="script-container">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <header class="top-bar">

                <div class="heading-section">

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="back-button"
                       title="Back to Dashboard"
                       aria-label="Back to Dashboard">

                        ←

                    </a>


                    <div class="page-icon">
                        ⚡
                    </div>


                    <div class="heading-text">

                        <div class="eyebrow">
                            ADMIN CONTROL CENTER
                        </div>

                        <h1>
                            Script Lab
                        </h1>

                        <p>
                            Send real-time client-side actions to connected dashboards.
                        </p>

                    </div>

                </div>


                <div class="connection-card">

                    <div id="connectionDot"
                         class="connection-dot">
                    </div>


                    <div class="connection-text">

                        <strong id="connectionText">
                            Connecting...
                        </strong>

                        <span>
                            SignalR ScriptHub
                        </span>

                    </div>

                </div>

            </header>



            <!-- =================================================
                 WORKSPACE
            ================================================== -->

            <div class="workspace">


                <!-- =================================================
                     SCRIPT EDITOR
                ================================================== -->

                <section class="panel">

                    <div class="panel-header">

                        <div class="panel-title">

                            <div class="panel-title-icon">
                                &lt;/&gt;
                            </div>


                            <div>

                                <h2>
                                    Script Editor
                                </h2>

                                <span>
                                    Write a client-side JavaScript action
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="editor-section">

                        <div class="editor-box">

                            <div class="editor-top">

                                <div class="editor-dots">

                                    <span></span>
                                    <span></span>
                                    <span></span>

                                </div>


                                <div class="editor-language">
                                    JavaScript
                                </div>

                            </div>


                            <textarea id="scriptInput"
                                      maxlength="5000"
                                      spellcheck="false"
                                      autocomplete="off"
                                      aria-label="JavaScript editor"
                                      placeholder="Write JavaScript here...

                            Example:
                            document.body.style.background = '#eef2ff';
                            document.querySelector('#previewTitle').textContent = 'Hello';"></textarea>

                        </div>



                        <div class="editor-footer">

                            <span id="characterCount"
                                  class="character-count">

                                0 / 5000

                            </span>


                            <div class="editor-actions">

                                <button type="button"
                                        id="clearButton"
                                        class="secondary-button">

                                    Clear

                                </button>


                                <button type="button"
                                        id="previewButton"
                                        class="secondary-button">

                                    ▶ Preview

                                </button>


                                <button type="button"
                                        id="sendButton"
                                        class="primary-button"
                                        disabled>

                                    ⚡ Send to Dashboard

                                </button>

                            </div>

                        </div>



                        <!-- =================================================
                             QUICK ACTIONS
                        ================================================== -->

                        <div class="templates">

                            <div class="templates-title">
                                Quick demo actions
                            </div>


                            <div class="template-list">


                                <button type="button"
                                        class="template-button"
                                        data-script="document.body.style.background = 'linear-gradient(135deg, #667eea, #764ba2)';">

                                    🎨 Change Background

                                </button>


                                <button type="button"
                                        class="template-button"
                                        data-script="document.querySelector('#previewTitle').textContent = 'Updated by Admin';">

                                    ✏️ Change Heading

                                </button>


                                <button type="button"
                                        class="template-button"
                                        data-script="document.body.style.fontFamily = 'Arial, sans-serif';">

                                    🔤 Change Font

                                </button>


                                <button type="button"
                                        class="template-button"
                                        data-script="document.querySelector('#previewCard').style.border = '4px solid #4f46e5';">

                                    ✨ Add Highlight

                                </button>


                            </div>

                        </div>

                    </div>

                </section>



                <!-- =================================================
                     LIVE PREVIEW
                ================================================== -->

                <section class="panel">

                    <div class="panel-header">

                        <div class="panel-title">

                            <div class="panel-title-icon">
                                ◉
                            </div>


                            <div>

                                <h2>
                                    Live Dashboard Preview
                                </h2>

                                <span>
                                    Isolated sandbox environment
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="preview-body">

                        <div class="preview-frame">

                            <iframe id="scriptSandbox"
                                    sandbox="allow-scripts"
                                    title="Live Script Preview">
                            </iframe>

                        </div>

                    </div>


                    <div id="executionStatus"
                         class="execution-status">

                        <div class="status-icon">
                            ⏳
                        </div>

                        <span id="statusText">
                            Waiting for a script...
                        </span>

                    </div>


                    <div class="info-card">

                        <strong>
                            🔐 Isolated preview + live broadcast
                        </strong>

                        <p>
                            Your script is executed as-is inside the isolated
                            preview. Sending uses SignalR to deliver the same
                            script to connected user dashboards.
                        </p>

                    </div>

                </section>

            </div>

        </div>

    </div>



    <!-- =========================================================
         PREVIEW DOCUMENT TEMPLATE

         The preview page lives here as real HTML markup inside an
         inert template element. The browser parses it as HTML, so the
         main ScriptLab JavaScript below never contains any HTML tag
         strings. The user's code is NEVER placed in this markup. It is
         passed later as plain data using postMessage.
    ========================================================== -->

    <template id="previewTemplate">

        <meta charset="UTF-8">

        <meta name="viewport"
              content="width=device-width, initial-scale=1.0">

        <title>Live Preview</title>

        <style>

                    * {
                        box-sizing: border-box;
                    }

                    html,
                    body {
                        width: 100%;
                        min-height: 100%;
                        margin: 0;
                    }

                    body {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        padding: 24px;
                        font-family: Inter, "Segoe UI", Arial, sans-serif;
                        background: linear-gradient( 135deg, #eef2ff, #f8fafc );
                        transition: background .3s ease, font-family .3s ease;
                    }

                    #previewCard {
                        width: 100%;
                        max-width: 330px;
                        padding: 30px;
                        background: white;
                        border: 1px solid #e2e8f0;
                        border-radius: 18px;
                        text-align: center;
                        box-shadow: 0 20px 45px rgba(15, 23, 42, .12);
                        transition: .3s ease;
                    }

                    .preview-icon {
                        width: 60px;
                        height: 60px;
                        margin: 0 auto 18px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 16px;
                        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
                        color: white;
                        font-size: 25px;
                    }

                    #previewTitle {
                        margin: 0;
                        color: #111827;
                        font-size: 22px;
                    }

                    .preview-text {
                        margin-top: 10px;
                        color: #64748b;
                        font-size: 13px;
                        line-height: 1.6;
                    }

                    .preview-status {
                        display: inline-block;
                        margin-top: 18px;
                        padding: 7px 12px;
                        border-radius: 999px;
                        background: #eef2ff;
                        color: #4f46e5;
                        font-size: 10px;
                        font-weight: 700;
                    }

        </style>

        <!-- Static bootstrap runner. It waits for a message that carries
             the code as plain text, then runs that exact text. -->
        <script>
                    (function () {

                        var AsyncFunction =
                            Object.getPrototypeOf(async function () { }).constructor;

                        var currentRunId = 0;

                        function post(message) {
                            window.parent.postMessage(message, "*");
                        }

                        function describe(error) {
                            if (error && error.message) {
                                return String(error.message);
                            }
                            return String(error);
                        }

                        function showError(message) {

                            var box = document.createElement("div");

                            box.style.cssText =
                                "font-family:Arial,sans-serif;" +
                                "padding:16px 18px;" +
                                "margin:16px 0 0;" +
                                "width:100%;" +
                                "border-radius:14px;" +
                                "background:#fef2f2;" +
                                "color:#b91c1c;" +
                                "line-height:1.6;" +
                                "font-size:13px;" +
                                "word-break:break-word;";

                            var title = document.createElement("strong");
                            title.textContent = "Preview error";

                            var text = document.createElement("div");
                            text.textContent = message;

                            box.appendChild(title);
                            box.appendChild(text);

                            (document.body || document.documentElement).appendChild(box);
                        }

                        function fail(error) {

                            var message = describe(error);

                            showError(message);

                            post({
                                type: "script-preview-error",
                                runId: currentRunId,
                                message: message
                            });
                        }

                        window.addEventListener("message", async function (event) {

                            if (event.source !== window.parent) {
                                return;
                            }

                            var data = event.data;

                            if (!data || data.type !== "run-script") {
                                return;
                            }

                            currentRunId = data.runId;

                            try {

                                var execute = new AsyncFunction(String(data.script));

                                await execute();

                                post({
                                    type: "script-preview-success",
                                    runId: currentRunId
                                });

                            }
                            catch (error) {

                                fail(error);

                            }

                        });

                        window.addEventListener("error", function (event) {
                            fail(event.error || event.message);
                        });

                        window.addEventListener("unhandledrejection", function (event) {
                            fail(event.reason);
                        });

                        post({ type: "preview-ready" });

                    })();
        </script>

        <div id="previewCard">

            <div class="preview-icon">
                ⚡
            </div>

            <h2 id="previewTitle">
                Live Dashboard
            </h2>

            <p class="preview-text">
                This is the isolated Script Lab preview.
            </p>

            <span class="preview-status">
                LIVE PREVIEW
            </span>

        </div>

    </template>



    <!-- =========================================================
         SIGNALR CLIENT
    ========================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>


    <script>

            "use strict";


            /* =========================================================
               CONFIGURATION
            ========================================================= */

            const MAX_SCRIPT_LENGTH = 5000;

            const PREVIEW_DEBOUNCE_MS = 400;

            const RECONNECT_DELAY_MS = 3000;


            /* =========================================================
               DOM ELEMENTS
            ========================================================= */

            const scriptInput = document.getElementById("scriptInput");
            const sendButton = document.getElementById("sendButton");
            const clearButton = document.getElementById("clearButton");
            const previewButton = document.getElementById("previewButton");
            const characterCount = document.getElementById("characterCount");
            const connectionDot = document.getElementById("connectionDot");
            const connectionText = document.getElementById("connectionText");
            const executionStatus = document.getElementById("executionStatus");
            const statusText = document.getElementById("statusText");
            const sandbox = document.getElementById("scriptSandbox");
            const previewTemplate = document.getElementById("previewTemplate");


            if (
                !scriptInput ||
                !sendButton ||
                !clearButton ||
                !previewButton ||
                !characterCount ||
                !connectionDot ||
                !connectionText ||
                !executionStatus ||
                !statusText ||
                !sandbox ||
                !previewTemplate
            ) {

                console.error("Script Lab initialization failed: required element missing.");

                throw new Error("Script Lab UI could not be initialized.");

            }


            /* =========================================================
               STATE
            ========================================================= */

            let isSending = false;

            let runCounter = 0;

            let pendingRun = null;

            let previewTimer = null;

            let reconnectTimer = null;

            let connectionStarting = false;


            /* =========================================================
               SIGNALR (single connection instance)
            ========================================================= */

            const connection =
                new signalR.HubConnectionBuilder()
                    .withUrl("/scriptHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000])
                    .build();


            function isConnected() {

                return connection.state === signalR.HubConnectionState.Connected;

            }


            /* =========================================================
               UI HELPERS
            ========================================================= */

            function setConnectionStatus(state, message) {

                connectionDot.classList.remove("connected", "error");

                if (state === "connected") {
                    connectionDot.classList.add("connected");
                }

                if (state === "error") {
                    connectionDot.classList.add("error");
                }

                connectionText.textContent = message;

            }


            function showStatus(message, type) {

                executionStatus.className = "execution-status";

                if (type) {
                    executionStatus.classList.add(type);
                }

                statusText.textContent = message;

            }


            function updateEditorState() {

                const length = scriptInput.value.length;

                characterCount.textContent = length + " / " + MAX_SCRIPT_LENGTH;

                sendButton.disabled =
                    isSending ||
                    !scriptInput.value.trim() ||
                    length > MAX_SCRIPT_LENGTH ||
                    !isConnected();

            }


            /* =========================================================
               PREVIEW

               The preview document comes from the inert template element
               above. The user's script is never concatenated into any
               HTML or into the outer JavaScript. It travels only as a
               plain string inside a postMessage payload.
            ========================================================= */

            function buildPreviewDocument() {

                /* No literal closing body/html tags and no angle brackets here:
                   Visual Studio Browser Link injects scripts at the first
                   closing body tag it finds in the response, which would
                   cut this script in half. */

                return "\u003C!DOCTYPE html>" + previewTemplate.innerHTML;

            }


            function renderPreview(script) {

                runCounter += 1;

                pendingRun = script.trim()
                    ? { runId: runCounter, script: script }
                    : null;

                sandbox.srcdoc = buildPreviewDocument();

            }


            function runPreviewFromEditor() {

                const script = scriptInput.value;

                renderPreview(script);

                if (!script.trim()) {

                    showStatus("Waiting for a script...");

                    return;

                }

                showStatus("Running script in live preview...");

            }


            function schedulePreview() {

                if (previewTimer !== null) {
                    window.clearTimeout(previewTimer);
                }

                previewTimer = window.setTimeout(function () {

                    previewTimer = null;

                    runPreviewFromEditor();

                }, PREVIEW_DEBOUNCE_MS);

            }


            function cancelScheduledPreview() {

                if (previewTimer !== null) {
                    window.clearTimeout(previewTimer);
                    previewTimer = null;
                }

            }


            window.addEventListener("message", function (event) {

                if (event.source !== sandbox.contentWindow) {
                    return;
                }

                const data = event.data;

                if (!data || !data.type) {
                    return;
                }

                if (data.type === "preview-ready") {

                    if (pendingRun) {

                        const run = pendingRun;

                        pendingRun = null;

                        sandbox.contentWindow.postMessage(
                            {
                                type: "run-script",
                                runId: run.runId,
                                script: run.script
                            },
                            "*"
                        );

                    }

                    return;
                }

                if (data.runId !== runCounter) {
                    return;
                }

                if (data.type === "script-preview-success") {

                    showStatus("Live preview executed successfully.", "success");

                    return;
                }

                if (data.type === "script-preview-error") {

                    showStatus(
                        "Preview error: " + (data.message || "Script failed."),
                        "error"
                    );

                }

            });


            /* =========================================================
               EDITOR INPUT
            ========================================================= */

            scriptInput.addEventListener("input", function () {

                updateEditorState();

                schedulePreview();

            });


            /* =========================================================
               CLEAR
            ========================================================= */

            clearButton.addEventListener("click", function () {

                cancelScheduledPreview();

                scriptInput.value = "";

                updateEditorState();

                renderPreview("");

                showStatus("Editor cleared.");

                scriptInput.focus();

            });


            /* =========================================================
               PREVIEW BUTTON
            ========================================================= */

            previewButton.addEventListener("click", function () {

                cancelScheduledPreview();

                if (!scriptInput.value.trim()) {

                    showStatus("Please enter a script first.", "error");

                    scriptInput.focus();

                    return;
                }

                runPreviewFromEditor();

            });


            /* =========================================================
               QUICK DEMO ACTIONS (load into editor only)
            ========================================================= */

            document
                .querySelectorAll(".template-button")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        cancelScheduledPreview();

                        scriptInput.value = this.dataset.script || "";

                        updateEditorState();

                        runPreviewFromEditor();

                        scriptInput.focus();

                    });

                });


            /* =========================================================
               SEND TO DASHBOARD (exact textarea value)
            ========================================================= */

            sendButton.addEventListener("click", async function () {

                if (isSending) {
                    return;
                }

                const script = scriptInput.value;

                if (!script.trim()) {

                    showStatus("Please enter a script first.", "error");

                    return;
                }

                if (script.length > MAX_SCRIPT_LENGTH) {

                    showStatus("Script is too long.", "error");

                    return;
                }

                if (!isConnected()) {

                    showStatus("SignalR is not connected yet.", "error");

                    return;
                }

                isSending = true;

                sendButton.textContent = "Sending...";

                updateEditorState();

                try {

                    await connection.invoke("SendScript", script);

                    showStatus("Script sent unchanged to connected dashboards.", "success");

                }
                catch (error) {

                    console.error("SendScript failed:", error);

                    showStatus(
                        error && error.message
                            ? error.message
                            : "Failed to send script.",
                        "error"
                    );

                }
                finally {

                    isSending = false;

                    sendButton.textContent = "⚡ Send to Dashboard";

                    updateEditorState();

                }

            });


            /* =========================================================
               SIGNALR LIFECYCLE
            ========================================================= */

            connection.onreconnecting(function () {

                setConnectionStatus("connecting", "Reconnecting...");

                updateEditorState();

            });


            connection.onreconnected(function () {

                setConnectionStatus("connected", "Connected");

                updateEditorState();

                showStatus("SignalR reconnected.", "success");

            });


            function scheduleReconnect() {

                if (reconnectTimer !== null) {
                    return;
                }

                reconnectTimer = window.setTimeout(function () {

                    reconnectTimer = null;

                    startConnection();

                }, RECONNECT_DELAY_MS);

            }


            connection.onclose(function (error) {

                console.warn("ScriptHub connection closed:", error);

                setConnectionStatus("error", "Disconnected");

                updateEditorState();

                scheduleReconnect();

            });


            async function startConnection() {

                if (connectionStarting) {
                    return;
                }

                if (connection.state !== signalR.HubConnectionState.Disconnected) {
                    return;
                }

                connectionStarting = true;

                setConnectionStatus("connecting", "Connecting...");

                try {

                    await connection.start();

                    console.log("ScriptHub connected successfully.");

                    setConnectionStatus("connected", "Connected");

                }
                catch (error) {

                    console.error("ScriptHub connection failed:", error);

                    setConnectionStatus("error", "Connection failed");

                    scheduleReconnect();

                }
                finally {

                    connectionStarting = false;

                    updateEditorState();

                }

            }


            /* =========================================================
               INITIALIZE
            ========================================================= */

            updateEditorState();

            renderPreview("");

            showStatus("Waiting for a script...");

            startConnection();

    </script>

</body>

</html>
