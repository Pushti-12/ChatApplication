@model ChatApplication.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-logo">✓</div>

        <div class="auth-title">
            Reset password
        </div>

        <div class="auth-subtitle">
            Create a new secure password.
        </div>

        <form asp-action="ResetPassword"
              method="post">

            <input asp-for="Email"
                   type="hidden" />

            <input asp-for="Token"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="auth-error">
            </div>

            <div class="auth-group">

                <label asp-for="Password"
                       class="auth-label">
                    New Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="auth-input"
                       placeholder="Enter new password" />

                <span asp-validation-for="Password"
                      class="auth-error">
                </span>

            </div>

            <div class="auth-group">

                <label asp-for="ConfirmPassword"
                       class="auth-label">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="auth-input"
                       placeholder="Confirm new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="auth-error">
                </span>

            </div>

            <button type="submit"
                    class="auth-button">
                Reset Password
            </button>

        </form>

        <div class="auth-links">
            <a asp-action="Login">
                ← Back to Login
            </a>
        </div>

    </div>

</div>